# App Stage
APP_STAGE=development

# Provider Selection (swap anytime)
AI_PROVIDER=ollama
STT_PROVIDER=mock
TTS_PROVIDER=mock

# Database URLs
POSTGRES_URL=postgresql://user:password@localhost:5432/interviewai
MONGODB_URL=mongodb://localhost:27017/interviewai
REDIS_URL=redis://localhost:6379

# Ports
API_GATEWAY_PORT=3000
AUTH_SERVICE_PORT=3001
INTERVIEW_SERVICE_PORT=3002
AI_SERVICE_PORT=8000
VOICE_SERVICE_PORT=3003
CODE_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# JWT (generate real keys later)
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# API Keys (add real ones later)
ZAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
